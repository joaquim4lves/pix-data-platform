# Copy to .env if you want to override the defaults in Settings.
# v0.1 talks to LocalStack. An empty AWS_ENDPOINT_URL selects real AWS (v0.4).

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=pix-data-local

BCB_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/Pix_DadosAbertos/versao/v1/odata
LOOKBACK_MONTHS=3
PAGE_SIZE=50000
HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_SECONDS=1

# v0.2 warehouse. local reads PIX_RAW_ROOT (layout raw/bcb/<entity>/ano_mes=YYYYMM).
# s3 reads the same prefix in S3_BUCKET through DuckDB httpfs. Use s3 after make ingest.
PIX_RAW_SOURCE=local
PIX_RAW_ROOT=data/raw
PIX_RAW_PREFIX=raw
PIX_DUCKDB_PATH=data/pix.duckdb

# Postgres is started by docker compose for the later OLTP slice. v0.1 ingestion does not use it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pix
POSTGRES_PASSWORD=pix
POSTGRES_DB=pix
