# Copy to .env if you want to override the defaults in Settings.
# v0.1 talks to LocalStack. Real AWS (v0.4) is an empty AWS_ENDPOINT_URL,
# or the sentinel "aws" (Lambda cannot store an empty value). Leave the
# access keys unset on real AWS so boto3 uses its credential chain, including
# the Lambda session token. Do not keep the dummy keys below in that case.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=pix-data-local

BCB_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/Pix_DadosAbertos/versao/v1/odata
LOOKBACK_MONTHS=3
PAGE_SIZE=50000
HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_SECONDS=1

# v0.2 warehouse. local reads PIX_RAW_ROOT (layout raw/bcb/<entity>/ano_mes=YYYYMM).
# s3 reads the same prefix in S3_BUCKET through DuckDB httpfs. Use s3 after make ingest.
PIX_RAW_SOURCE=local
PIX_RAW_ROOT=data/raw
PIX_RAW_PREFIX=raw
PIX_DUCKDB_PATH=data/pix.duckdb

# v0.5 dbt. The default target is duckdb and does not need these.
# PIX_ATHENA_WORKGROUP is the Terraform output athena_workgroup (pix-data-dev).
# PIX_ATHENA_STAGING_DIR is the athena_results output.
# PIX_ATHENA_DATA_DIR is s3://<lake-bucket>/curated/.
# PIX_GLUE_PREFIX matches catalog_prefix.
# PIX_ATHENA_WORKGROUP=pix-data-dev
# PIX_ATHENA_STAGING_DIR=s3://<lake-bucket>/athena-results/
# PIX_ATHENA_DATA_DIR=s3://<lake-bucket>/curated/
# PIX_GLUE_PREFIX=pix

# Postgres is the operational database (v0.3). Ingestion does not write to it.
# Compose starts it with wal_level=logical for the pgoutput consumer.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pix
POSTGRES_PASSWORD=pix
POSTGRES_DB=pix
# DATABASE_URL=postgresql+psycopg://pix:pix@localhost:5432/pix

API_HOST=0.0.0.0
API_PORT=8000

# Logical replication. The slot only sees commits made after it is created.
CDC_PUBLICATION=pix_app
CDC_SLOT=pix_app_slot
CDC_QUEUE=pix-cdc

# v0.6 local Airflow (docker compose profile `airflow`). Not used by Lambda.
# The Fernet key and JWT below are local placeholders. Do not reuse them anywhere
# except this compose stack. Leave the Slack URL empty to log alerts only.
# AIRFLOW_UID should be the host user (`id -u`) so logs and DuckDB are writable.
AIRFLOW_UID=1000
AIRFLOW_FERNET_KEY=mDcm7GibWr4ykbfhwNaePHmLbvzEdj5E7lNAK-Hj6qQ=
AIRFLOW_JWT_SECRET=local-only-airflow-jwt
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_API_SERVER_PORT=8080
OLINDA_POOL_SLOTS=1
DUCKDB_POOL_SLOTS=1
CDC_SLOT_LAG_BYTES=268435456
# AIRFLOW_ALERT_SLACK_WEBHOOK_URL=
